<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout for WordOfTheDayWidget. The provider fills the text and sets the
     definition's line count per widget size; the placeholder text shows only until the first
     update lands. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/widget_label"
        android:textAllCaps="true"
        android:textColor="@color/widget_accent"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_term"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_secondary_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />
</LinearLayout>
